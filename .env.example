# ==============================================================================
# GUS RESEARCH LAB — ORACLE CLOUD PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# PostgreSQL Database Configuration (Oracle Cloud Production Default)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/guslab
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgrespassword
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
SPRING_JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# For Samsung M31 / Local H2 Fallback:
# SPRING_DATASOURCE_URL=jdbc:h2:file:/app/data/guslabdb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE;MODE=PostgreSQL
# SPRING_DATASOURCE_USERNAME=sa
# SPRING_DATASOURCE_PASSWORD=
# SPRING_DATASOURCE_DRIVER=org.h2.Driver
# SPRING_JPA_DIALECT=org.hibernate.dialect.H2Dialect

POSTGRES_DB=guslab
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword

# Security & JWT Configuration
JWT_SECRET=GusResearchLabSuperSecretKeyThatIsAtLeast256BitsLongForSecurityJWTSigning2026*
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=https://gusresearchlab.is-a.bot,https://kundali.gusresearchlab.is-a.bot,http://localhost:5173,http://localhost:80,http://localhost

# Frontend API Endpoint Configuration
VITE_API_BASE_URL=/api
