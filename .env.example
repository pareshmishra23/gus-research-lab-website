# ==========================================
# GUS RESEARCH LAB ENVIRONMENT CONFIGURATION
# ==========================================

# Database Configuration (PostgreSQL / H2)
POSTGRES_DB=guslab
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_PORT=5432

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/guslab
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgrespassword
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# Spring Boot Application Ports & JWT Secret
BACKEND_PORT=8080
JWT_SECRET=GusResearchLabSuperSecretKeyThatIsAtLeast256BitsLongForSecurityJWTSigning2026*
JWT_EXPIRATION_MS=86400000

# CORS & Frontend Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost

# Frontend Configuration
FRONTEND_PORT=80
VITE_API_BASE_URL=/api
